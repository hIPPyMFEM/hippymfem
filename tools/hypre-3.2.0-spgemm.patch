+/* HYPRE_SPGEMM_SKIP_SORT in the environment: 0 has every operand copied and sorted by
+ * rocSPARSE, as hypre does; 1 uses an operand whose rows ascend as it is; 2 also writes the
+ * sorted copy of an operand with its first entries out of place in one pass; anything else,
+ * or nothing, also has a diagonal block and its off-processor one joined with their rows
+ * in order (hypre_ConcatDiagAndOffdDevice) */
+static HYPRE_Int
+hypre_CSRSpGemmSkipSort(void)
+{
+   static HYPRE_Int skip_sort = -1;
+
+   if (skip_sort < 0)
+   {
+      char *env = getenv("HYPRE_SPGEMM_SKIP_SORT");
+      skip_sort = (env && env[0] == '0') ? 0 : (env && env[0] == '1') ? 1 : 2;
+   }
+
+   return skip_sort;
+}
+
+static HYPRE_Int
+hypre_CSRSpGemmDiagFirstPass(void)
+{
+   return hypre_CSRSpGemmSkipSort() > 1;
+}
