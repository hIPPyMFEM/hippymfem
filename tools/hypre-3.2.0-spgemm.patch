+                                   HYPRE_Complex *d_a_sorted)
+{
+   HYPRE_Int  other = 0;
+   HYPRE_Int *d_other;
+
+   if (nrows <= 0 || nnz <= 0)
+   {
+      return 0;
+   }
+
+   d_other = hypre_CTAlloc(HYPRE_Int, 1, HYPRE_MEMORY_DEVICE);
+
+   dim3 bDim = hypre_GetDefaultDeviceBlockDimension();
+   dim3 gDim = hypre_GetDefaultDeviceGridDimension(nrows, "warp", bDim);
