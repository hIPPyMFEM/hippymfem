+
+   hypre_ForceSyncComputeStream();
+   hypre_TMemcpy(&other, d_other, HYPRE_Int, 1, HYPRE_MEMORY_HOST, HYPRE_MEMORY_DEVICE);
+   hypre_TFree(d_other, HYPRE_MEMORY_DEVICE);
+
+   return !other;
+}
