+/* The largest operand of a setup is not sorted: the diagonal block of a square matrix of
+ * hypre has the diagonal entry of each row first, and the block that joins it with the
+ * off-processor one inherits that.  Where the matrix was assembled with its other entries
+ * in ascending order (the fine matrix of a solve), a row is sorted by moving that one
+ * entry, and the sorted copy is written here in one pass, a warp a row, instead of being
+ * copied and handed to rocSPARSE's sort with a permutation and a second copy of the values
+ * beside it (22 bytes a nonzero of device memory taken and given back).  A row of another
+ * kind raises the flag and the caller sorts as before. */
+__global__ void
+hypre_GPUKernelCSRSpGemmSortedCopyDiagFirst( hypre_DeviceItem &item,
+                                             HYPRE_Int         nrows,
+                                             HYPRE_Int        *ia,
+                                             HYPRE_Int        *ja,
+                                             HYPRE_Complex    *aa,
+                                             HYPRE_Int        *js,
+                                             HYPRE_Complex    *as,
+                                             HYPRE_Int        *other )
+{
+   const HYPRE_Int row  = hypre_gpu_get_grid_warp_id<1, 1>(item);
+   const HYPRE_Int lane = hypre_gpu_get_lane_id<1>(item);
+
+   if (row >= nrows)
+   {
+      return;
+   }
+
+   HYPRE_Int p = 0, q = 0, d = 0;
+
+   if (lane < 2)
+   {
+      p = read_only_load(ia + row + lane);
+   }
+   q = warp_shuffle_sync(item, HYPRE_WARP_FULL_MASK, p, 1);
+   p = warp_shuffle_sync(item, HYPRE_WARP_FULL_MASK, p, 0);
+
+   if (q <= p)
+   {
+      return;
+   }
+
+   /* the first entry of the row, and its place when none of the others is smaller */
+   if (lane == 0)
+   {
+      d = read_only_load(ja + p);
+      if (p + 1 == q || read_only_load(ja + p + 1) > d)
+      {
+         js[p] = d;
+         as[p] = read_only_load(aa + p);
+      }
+   }
+   d = warp_shuffle_sync(item, HYPRE_WARP_FULL_MASK, d, 0);
+
+   /* the others: one place down when smaller than the first, and the first behind the
+    * last of those */
+   for (HYPRE_Int j = p + 1 + lane; j < q; j += HYPRE_WARP_SIZE)
+   {
+      const HYPRE_Int c    = read_only_load(ja + j);
+      const HYPRE_Int last = (j + 1 == q);
+      const HYPRE_Int next = last ? c : read_only_load(ja + j + 1);
