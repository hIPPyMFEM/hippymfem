+ * matrix as it is.  The rows of a diagonal block have the diagonal entry first; where the
+ * other entries ascend, and those of the off-processor block do, the first entry is put in
+ * its place as the row is written.  A row of another kind raises the flag, and the caller
+ * writes the matrix again with the kernel above. */
+__global__ void
+hypre_GPUKernelConcatDiagAndOffdSorted( hypre_DeviceItem &item,
+                                        HYPRE_Int  nrows,    HYPRE_Int  diag_ncol,
+                                        HYPRE_Int *d_diag_i, HYPRE_Int *d_diag_j, HYPRE_Complex *d_diag_a,
+                                        HYPRE_Int *d_offd_i, HYPRE_Int *d_offd_j, HYPRE_Complex *d_offd_a,
+                                        HYPRE_Int *d_ib,     HYPRE_Int *d_jb,     HYPRE_Complex *d_ab,
+                                        HYPRE_Int *other )
+{
+   const HYPRE_Int row = hypre_gpu_get_grid_warp_id<1, 1>(item);
+
+   if (row >= nrows)
+   {
+      return;
+   }
+
+   /* lane id inside the warp */
+   const HYPRE_Int lane_id = hypre_gpu_get_lane_id<1>(item);
+   HYPRE_Int i, j = 0, k = 0, d = 0, p, istart, iend, bstart;
+
+   /* diag part */
+   if (lane_id < 2)
+   {
+      j = read_only_load(d_diag_i + row + lane_id);
+   }
+   if (lane_id == 0)
+   {
+      k = read_only_load(d_ib + row);
+   }
+   istart = warp_shuffle_sync(item, HYPRE_WARP_FULL_MASK, j, 0);
+   iend   = warp_shuffle_sync(item, HYPRE_WARP_FULL_MASK, j, 1);
+   bstart = warp_shuffle_sync(item, HYPRE_WARP_FULL_MASK, k, 0);
+
+   p = bstart - istart;
+   if (iend > istart)
+   {
+      /* the first entry, and its place when none of the others is smaller */
+      if (lane_id == 0)
+      {
+         d = read_only_load(d_diag_j + istart);
+         if (istart + 1 == iend || read_only_load(d_diag_j + istart + 1) > d)
+         {
+            d_jb[p + istart] = d;
+            d_ab[p + istart] = read_only_load(d_diag_a + istart);
+         }
+      }
+      d = warp_shuffle_sync(item, HYPRE_WARP_FULL_MASK, d, 0);
+
+      /* the others: one place down when smaller than the first, and the first behind
+       * the last of those */
+      for (i = istart + 1 + lane_id; i < iend; i += HYPRE_WARP_SIZE)
+      {
+         const HYPRE_Int c    = read_only_load(d_diag_j + i);
+         const HYPRE_Int last = (i + 1 == iend);
+         const HYPRE_Int next = last ? c : read_only_load(d_diag_j + i + 1);
+
+         if (c == d || (!last && c >= next))
+         {
+            *other = 1;
+         }
+         if (c < d)
+         {
+            d_jb[p + i - 1] = c;
+            d_ab[p + i - 1] = read_only_load(d_diag_a + i);
+            if (last || next > d)
+            {
+               d_jb[p + i] = d;
+               d_ab[p + i] = read_only_load(d_diag_a + istart);
+            }
+         }
+         else
+         {
+            d_jb[p + i] = c;
+            d_ab[p + i] = read_only_load(d_diag_a + i);
+         }
+      }
+   }
+
