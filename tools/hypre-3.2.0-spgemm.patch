+/* hIPPyMFEM (tools/hypre-3.2.0-spgemm.patch).  rocSPARSE is given the column indices of each
+ * row in ascending order, and hypre sorts a copy of both operands before every product.  A
+ * setup of BoomerAMG multiplies matrices that are sorted already: a transpose, the result of
+ * the product before.  The copy and the sort of such an operand are most of the time of the
+ * product, and several GB of device memory taken and given back.  The rows are checked
+ * here, in one pass over the column indices, and an operand whose rows ascend is used as it
+ * is. */
+struct hypre_CSRSpGemmRowDescends
+{
+   const HYPRE_Int *ia, *ja;
+
+   hypre_CSRSpGemmRowDescends(const HYPRE_Int *ia_, const HYPRE_Int *ja_) : ia(ia_), ja(ja_) {}
+
+   __host__ __device__ bool operator()(const HYPRE_Int i) const
+   {
+      for (HYPRE_Int k = ia[i]; k < ia[i + 1] - 1; k++)
+      {
+         if (ja[k] >= ja[k + 1])
+         {
+            return true;
+         }
+      }
+      return false;
+   }
+};
