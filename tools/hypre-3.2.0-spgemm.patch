+static HYPRE_Int
+hypre_CSRSpGemmRowsAscend(HYPRE_Int        nrows,
+                          const HYPRE_Int *d_ia,
+                          const HYPRE_Int *d_ja)
+{
+   if (!hypre_CSRSpGemmSkipSort())
+   {
+      return 0;
+   }
+
+   return 0 == HYPRE_THRUST_CALL( count_if,
+                                  thrust::make_counting_iterator(0),
+                                  thrust::make_counting_iterator(nrows),
+                                  hypre_CSRSpGemmRowDescends(d_ia, d_ja) );
+}
