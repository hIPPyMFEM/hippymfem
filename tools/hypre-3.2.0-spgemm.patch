+      }
+      if (c < d)
+      {
+         js[j - 1] = c;
+         as[j - 1] = read_only_load(aa + j);
+         if (last || next > d)
+         {
+            js[j] = d;
+            as[j] = read_only_load(aa + p);
+         }
+      }
+      else
+      {
+         js[j] = c;
+         as[j] = read_only_load(aa + j);
+      }
+   }
+}
