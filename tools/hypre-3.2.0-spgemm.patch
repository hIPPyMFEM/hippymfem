+/* the sorted copy of a matrix whose rows are sorted but for their first entry; returns 0,
+ * with the copy to be made anew, when some row is of another kind */
+static HYPRE_Int
+hypre_CSRSpGemmSortedCopyDiagFirst(HYPRE_Int      nrows,
