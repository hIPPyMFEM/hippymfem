From b5630b275b97246af2fcf0902004b5bd06ea451c Mon Sep 17 00:00:00 2001
From: pchen402 <pchen402@gatech.edu>
Date: Sun, 8 Nov 2026 22:20:00 -0500
Subject: [PATCH] Keep the staging buffers of exchanges through CPU memory, and
 start a staged exchange before the local product

---
 src/parcsr_mv/par_csr_communication.c | 131 ++++++++++++++++++++++++--
 src/parcsr_mv/par_csr_matvec_device.c |  55 +++++++++--
 2 files changed, 172 insertions(+), 14 deletions(-)

diff --git a/src/parcsr_mv/par_csr_communication.c b/src/parcsr_mv/par_csr_communication.c
index 8210bd20..7e274f7d 100644
--- a/src/parcsr_mv/par_csr_communication.c
+++ b/src/parcsr_mv/par_csr_communication.c
@@ -336,6 +336,111 @@ hypre_ParCSRPersistentCommHandleWait( hypre_ParCSRPersistentCommHandle *comm_han
 }
 #endif // HYPRE_USING_PERSISTENT_COMM
 
+/*------------------------------------------------------------------
+ * Staging buffers for an exchange of device data (hIPPyMFEM,
+ * tools/hypre-3.2.0-staging.patch).
+ *
+ * Without a GPU-aware MPI every exchange copies its send buffer from the
+ * device to CPU memory and its receive buffer back.  hypre allocates the
+ * two CPU buffers with malloc for every exchange and frees them at its
+ * end, so the copies go to and from pageable memory.  Here they are
+ * page-locked buffers that are kept: a buffer is taken from a small set
+ * (the smallest free one that is large enough, or a new one of the next
+ * power of two) and given back at the end of the exchange.
+ * HYPRE_STAGE_PINNED=0 in the environment restores hypre's own buffers.
+ *------------------------------------------------------------------*/
+#if defined(HYPRE_USING_GPU)
+#define HM_NPIN 48
+static char  *hm_pin_ptr[HM_NPIN];
+static size_t hm_pin_cap[HM_NPIN];
+static int    hm_pin_used[HM_NPIN];
+static int    hm_pin_on = -1;
+
+static char *
+hm_pin_get( size_t n )
+{
+   int i, best = -1;
+   size_t cap;
+
+   if (hm_pin_on < 0)
+   {
+      char *e = getenv("HYPRE_STAGE_PINNED");
+      hm_pin_on = (e && e[0] == '0') ? 0 : 1;
+   }
+   if (!hm_pin_on || n == 0)
+   {
+      return NULL;
+   }
+   for (i = 0; i < HM_NPIN; i++)
+   {
+      if (!hm_pin_used[i] && hm_pin_ptr[i] && hm_pin_cap[i] >= n &&
+          (best < 0 || hm_pin_cap[i] < hm_pin_cap[best]))
+      {
+         best = i;
+      }
+   }
+   if (best < 0)
+   {
+      for (i = 0; i < HM_NPIN; i++)
+      {
+         if (!hm_pin_used[i] && !hm_pin_ptr[i]) { best = i; break; }
+      }
+      if (best < 0)
+      {
+         /* every slot holds a buffer: give up a free one that is too small */
+         for (i = 0; i < HM_NPIN; i++)
+         {
+            if (!hm_pin_used[i])
+            {
+               hypre__Free(hm_pin_ptr[i], hypre_MEMORY_HOST_PINNED);
+               hm_pin_ptr[i] = NULL;
+               best = i;
+               break;
+            }
+         }
+      }
+      if (best < 0)
+      {
+         return NULL;
+      }
+      cap = 65536;
+      while (cap < n) { cap *= 2; }
+      hm_pin_ptr[best] = (char *) hypre__MAlloc(cap, hypre_MEMORY_HOST_PINNED);
+      if (!hm_pin_ptr[best])
+      {
+         return NULL;
+      }
+      hm_pin_cap[best] = cap;
+   }
+   hm_pin_used[best] = 1;
+   return hm_pin_ptr[best];
+}
+
+/* 1 when p was one of the kept buffers (and is free again), 0 otherwise */
+static int
+hm_pin_put( void *p )
+{
+   int i;
+   if (!p)
+   {
+      return 0;
+   }
+   for (i = 0; i < HM_NPIN; i++)
+   {
+      if (hm_pin_ptr[i] && (void *) hm_pin_ptr[i] == p)
+      {
+         hm_pin_used[i] = 0;
+         return 1;
+      }
+   }
+   return 0;
+}
+#else
+#define hm_pin_get(n) NULL
+#define hm_pin_put(p) 0
+#endif
+
+
 /*------------------------------------------------------------------
  * hypre_ParCSRCommHandleCreate
  *------------------------------------------------------------------*/
@@ -461,8 +566,11 @@ hypre_ParCSRCommHandleCreate_v2 ( HYPRE_Int            job,
       if ( act_send_memory_location == hypre_MEMORY_DEVICE ||
            act_send_memory_location == hypre_MEMORY_UNIFIED )
       {
-         //send_data = _hypre_TAlloc(char, num_send_bytes, hypre_MEMORY_HOST_PINNED);
-         send_data = hypre_TAlloc(char, num_send_bytes, HYPRE_MEMORY_HOST);
+         send_data = hm_pin_get((size_t) num_send_bytes);
+         if (!send_data)
+         {
+            send_data = hypre_TAlloc(char, num_send_bytes, HYPRE_MEMORY_HOST);
+         }
          hypre_GpuProfilingPushRange("MPI-D2H");
          hypre_TMemcpy(send_data, send_data_in, char, num_send_bytes, HYPRE_MEMORY_HOST,
                        HYPRE_MEMORY_DEVICE);
@@ -478,8 +586,11 @@ hypre_ParCSRCommHandleCreate_v2 ( HYPRE_Int            job,
       if ( act_recv_memory_location == hypre_MEMORY_DEVICE ||
            act_recv_memory_location == hypre_MEMORY_UNIFIED )
       {
-         //recv_data = hypre_TAlloc(char, num_recv_bytes, hypre_MEMORY_HOST_PINNED);
-         recv_data = hypre_TAlloc(char, num_recv_bytes, HYPRE_MEMORY_HOST);
+         recv_data = hm_pin_get((size_t) num_recv_bytes);
+         if (!recv_data)
+         {
+            recv_data = hypre_TAlloc(char, num_recv_bytes, HYPRE_MEMORY_HOST);
+         }
       }
       else
       {
@@ -691,8 +802,10 @@ hypre_ParCSRCommHandleDestroy( hypre_ParCSRCommHandle *comm_handle )
       if ( act_send_memory_location == hypre_MEMORY_DEVICE ||
            act_send_memory_location == hypre_MEMORY_UNIFIED )
       {
-         //hypre_HostPinnedFree(hypre_ParCSRCommHandleSendDataBuffer(comm_handle));
-         hypre_TFree(hypre_ParCSRCommHandleSendDataBuffer(comm_handle), HYPRE_MEMORY_HOST);
+         if (!hm_pin_put(hypre_ParCSRCommHandleSendDataBuffer(comm_handle)))
+         {
+            hypre_TFree(hypre_ParCSRCommHandleSendDataBuffer(comm_handle), HYPRE_MEMORY_HOST);
+         }
       }
 
       hypre_MemoryLocation act_recv_memory_location =
@@ -709,8 +822,10 @@ hypre_ParCSRCommHandleDestroy( hypre_ParCSRCommHandle *comm_handle )
                         HYPRE_MEMORY_DEVICE,
                         HYPRE_MEMORY_HOST );
          hypre_GpuProfilingPopRange();
-         //hypre_HostPinnedFree(hypre_ParCSRCommHandleRecvDataBuffer(comm_handle));
-         hypre_TFree(hypre_ParCSRCommHandleRecvDataBuffer(comm_handle), HYPRE_MEMORY_HOST);
+         if (!hm_pin_put(hypre_ParCSRCommHandleRecvDataBuffer(comm_handle)))
+         {
+            hypre_TFree(hypre_ParCSRCommHandleRecvDataBuffer(comm_handle), HYPRE_MEMORY_HOST);
+         }
       }
    }
 
diff --git a/src/parcsr_mv/par_csr_matvec_device.c b/src/parcsr_mv/par_csr_matvec_device.c
index 0e159ae3..a8972990 100644
--- a/src/parcsr_mv/par_csr_matvec_device.c
+++ b/src/parcsr_mv/par_csr_matvec_device.c
@@ -21,6 +21,19 @@
  * hypre_ParCSRMatrixMatvecOutOfPlaceDevice
  *--------------------------------------------------------------------------*/
 
+/* hIPPyMFEM: whether a staged exchange starts before the local product (HYPRE_STAGE_EARLY) */
+static HYPRE_Int
+hm_stage_early(void)
+{
+   static HYPRE_Int on = -1;
+   if (on < 0)
+   {
+      char *e = getenv("HYPRE_STAGE_EARLY");
+      on = (e && e[0] == '0') ? 0 : 1;
+   }
+   return on;
+}
+
 HYPRE_Int
 hypre_ParCSRMatrixMatvecOutOfPlaceDevice( HYPRE_Complex       alpha,
                                           hypre_ParCSRMatrix *A,
@@ -223,6 +236,20 @@ hypre_ParCSRMatrixMatvecOutOfPlaceDevice( HYPRE_Complex       alpha,
       hypre_ForceSyncComputeStream();
    }
 
+   /* hIPPyMFEM (tools/hypre-3.2.0-staging.patch): with the exchange staged through CPU
+    * memory, the copy of the send buffer to the host waits for what the device has queued.
+    * Started after the local product, it waits for that product and the messages travel
+    * after it; started before, they travel while the device computes it.
+    * HYPRE_STAGE_EARLY=0 in the environment restores hypre's order. */
+   HYPRE_Int hm_early = (num_procs > 1) && !hypre_GetGpuAwareMPI() && hm_stage_early();
+
+   if (hm_early)
+   {
+      comm_handle = hypre_ParCSRCommHandleCreate_v2(1, comm_pkg,
+                                                    HYPRE_MEMORY_DEVICE, x_buf_data,
+                                                    HYPRE_MEMORY_DEVICE, x_tmp_data);
+   }
+
    /* when using GPUs, start local matvec first in order to overlap with communication */
    hypre_CSRMatrixMatvecOutOfPlace(alpha, diag, x_local, beta, b_local, y_local, 0);
 
@@ -233,9 +260,12 @@ hypre_ParCSRMatrixMatvecOutOfPlaceDevice( HYPRE_Complex       alpha,
    /* Non-blocking communication starts */
    if (num_procs > 1)
    {
-      comm_handle = hypre_ParCSRCommHandleCreate_v2(1, comm_pkg,
-                                                    HYPRE_MEMORY_DEVICE, x_buf_data,
-                                                    HYPRE_MEMORY_DEVICE, x_tmp_data);
+      if (!hm_early)
+      {
+         comm_handle = hypre_ParCSRCommHandleCreate_v2(1, comm_pkg,
+                                                       HYPRE_MEMORY_DEVICE, x_buf_data,
+                                                       HYPRE_MEMORY_DEVICE, x_tmp_data);
+      }
 
       /* Non-blocking communication ends */
       hypre_ParCSRCommHandleDestroy(comm_handle);
@@ -450,6 +480,16 @@ hypre_ParCSRMatrixMatvecTDevice( HYPRE_Complex       alpha,
       hypre_ForceSyncComputeStream();
    }
 
+   /* hIPPyMFEM: as in the product above, the staged exchange starts before the local one */
+   HYPRE_Int hm_early = !hypre_GetGpuAwareMPI() && hm_stage_early();
+
+   if (hm_early)
+   {
+      comm_handle = hypre_ParCSRCommHandleCreate_v2(2, comm_pkg,
+                                                    HYPRE_MEMORY_DEVICE, y_tmp_data,
+                                                    HYPRE_MEMORY_DEVICE, y_buf_data );
+   }
+
    /* when using GPUs, start local matvec first in order to overlap with communication */
    if (diagT)
    {
@@ -466,9 +506,12 @@ hypre_ParCSRMatrixMatvecTDevice( HYPRE_Complex       alpha,
 #endif
 
    /* Non-blocking communication starts */
-   comm_handle = hypre_ParCSRCommHandleCreate_v2(2, comm_pkg,
-                                                 HYPRE_MEMORY_DEVICE, y_tmp_data,
-                                                 HYPRE_MEMORY_DEVICE, y_buf_data );
+   if (!hm_early)
+   {
+      comm_handle = hypre_ParCSRCommHandleCreate_v2(2, comm_pkg,
+                                                    HYPRE_MEMORY_DEVICE, y_tmp_data,
+                                                    HYPRE_MEMORY_DEVICE, y_buf_data );
+   }
 
    /* Non-blocking communication ends */
    hypre_ParCSRCommHandleDestroy(comm_handle);
