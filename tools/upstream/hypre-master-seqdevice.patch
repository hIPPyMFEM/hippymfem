From ea04cfcf8521f5c415e2c9eaffba116e5ae9b61c Mon Sep 17 00:00:00 2001
From: pchen402 <pchen402@gatech.edu>
Date: Sun, 8 Nov 2026 22:20:38 -0500
Subject: [PATCH] hIPPyMFEM patch seqdevice for hypre master

---
 src/parcsr_ls/gen_redcs_mat.c | 442 ++++++++++++++++++++++++++++++++++
 src/parcsr_ls/par_amg_setup.c |   9 +
 2 files changed, 451 insertions(+)

diff --git a/src/parcsr_ls/gen_redcs_mat.c b/src/parcsr_ls/gen_redcs_mat.c
index a8189028..63093331 100644
--- a/src/parcsr_ls/gen_redcs_mat.c
+++ b/src/parcsr_ls/gen_redcs_mat.c
@@ -11,6 +11,432 @@
 
 #define USE_ALLTOALL 0
 
+/*--------------------------------------------------------------------------
+ * The gathered coarse solve with hypre on a device
+ * (hippymfem, tools/hypre-3.2.0-seqdevice.patch)
+ *
+ * HYPRE_BoomerAMGSetSeqThreshold(solver, n) ends a hierarchy at its first level of at
+ * most n rows and gathers that level on the ranks that hold rows of it, where a
+ * BoomerAMG of one process finishes it.  The code further down reads the level's
+ * matrix and vectors through host pointers and faults with hypre on a device.  The
+ * last levels of a hierarchy on thousands of ranks are a few rows a rank that talk to
+ * many ranks: each costs four exchanges a cycle whatever its size, and together they
+ * were a third to a half of a cycle of a linear-element hierarchy on 512 MI250X.
+ *
+ * For a level in device memory, here: its matrix is read from a copy in host memory;
+ * the gathered matrix is put together in host memory and moved to the device, where
+ * the one-process hierarchy is set up and applied; a cycle brings each rank's part of
+ * the right-hand side to the host, gathers, and hands the whole to the device.  The
+ * counts of the gather are kept from the set-up, and the iterate of the level is taken
+ * as zero, as it is where a cycle comes down to its last level (it is gathered where
+ * that level is the matrix itself: one of at most n rows that cannot be coarsened, a
+ * hierarchy of one level, which hypre's cycle relaxes without coming here, so that
+ * branch has not been run).
+ *
+ * Who solves.  The first of the ranks, which then sends the whole solution to the
+ * others: one solver, so the correction is one linear map.  With
+ * HYPRE_BoomerAMGSetRedundant(solver, 1) every rank solves the whole system and keeps
+ * its own rows of its own solution, which saves that broadcast.  The correction is then
+ * one map only where every rank's solver is the same, and hypre's coarsening on a device
+ * draws its random numbers from one generator a process, which stands wherever the
+ * process's earlier hierarchies left it.  Two hierarchies of one matrix agree to the 10
+ * or 20 % that a cycle leaves of an error, so the ranks' corrections did not fit at the
+ * seams between their rows: a conjugate gradient iteration with such a cycle took 78
+ * iterations where it takes 7, or stalled.  So the generator is set back before each
+ * rank's set-up, and the solvers are compared on one right-hand side; where they differ
+ * the first rank solves, as without the setting.
+ *--------------------------------------------------------------------------*/
+
+HYPRE_Int
+hypre_BoomerAMGSeqOnDevice( void );
+HYPRE_Int
+hypre_BoomerAMGSeqSolvers( void *solver );
+
+HYPRE_Int
+hypre_BoomerAMGSeqOnDevice( void )     /* the mark of a library that has this: 2 since
+                                          the ranks' solvers are compared, 3 since a
+                                          level that cannot be coarsened is not gathered
+                                          above the threshold and a system's level is
+                                          gathered with the functions of its rows */
+{
+   return 3;
+}
+
+/* Who solves the gathered level of a hierarchy that is set up: 1 every rank, 0 the first
+ * of them, -1 where this rank holds no row of such a level (or there is none, or it is in
+ * host memory). */
+HYPRE_Int
+hypre_BoomerAMGSeqSolvers( void *solver )
+{
+#if defined(HYPRE_USING_GPU)
+   hypre_ParAMGData *amg_data = (hypre_ParAMGData *) solver;
+   HYPRE_Int        *info = amg_data ? hypre_ParAMGDataCommInfo(amg_data) : NULL;
+   HYPRE_Int         num_levels = amg_data ? hypre_ParAMGDataNumLevels(amg_data) : 0;
+   HYPRE_Int         np;
+
+   if (info && num_levels > 0 && hypre_ParAMGDataParticipate(amg_data) &&
+       hypre_ParAMGDataNewComm(amg_data) != hypre_MPI_COMM_NULL &&
+       hypre_GetExecPolicy1(hypre_ParCSRMatrixMemoryLocation(
+                               hypre_ParAMGDataAArray(amg_data)[num_levels - 1])) == HYPRE_EXEC_DEVICE)
+   {
+      hypre_MPI_Comm_size(hypre_ParAMGDataNewComm(amg_data), &np);
+      return info[2 * np + 1];
+   }
+#else
+   HYPRE_UNUSED_VAR(solver);
+#endif
+   return -1;
+}
+
+#if defined(HYPRE_USING_GPU)
+
+/* What a rank keeps of the gather (hypre_ParAMGDataCommInfo): the rows of every rank,
+ * where they start, their sum, and whether every rank solves. */
+#define hypre_SeqInfoAllSolve(info, np) ((info)[2 * (np) + 1])
+
+static HYPRE_Int
+hypre_seqAMGSetupDevice( hypre_ParAMGData *amg_data,
+                         HYPRE_Int         level )
+{
+   hypre_ParCSRMatrix    *A = hypre_ParAMGDataAArray(amg_data)[level];
+   MPI_Comm               comm = hypre_ParCSRMatrixComm(A);
+   MPI_Comm               new_comm;
+   HYPRE_MemoryLocation   memory_location = hypre_ParCSRMatrixMemoryLocation(A);
+   HYPRE_Int              num_rows = hypre_CSRMatrixNumRows(hypre_ParCSRMatrixDiag(A));
+   HYPRE_BigInt           first_row_index = hypre_ParCSRMatrixFirstRowIndex(A);
+
+   hypre_GenerateSubComm(comm, num_rows, &new_comm);
+
+   /* Every rank takes the gathered solve for its coarsest level, also one that holds no
+    * row of it and has nothing to do there: left to the cycle's own coarsest relaxation
+    * it would set a Gaussian elimination up, which is a collective of all the ranks,
+    * while the others gather among themselves. */
+   hypre_ParAMGDataParticipate(amg_data) = 1;
+
+   if (num_rows)
+   {
+      hypre_ParCSRMatrix *A_h = hypre_ParCSRMatrixClone_v2(A, 1, HYPRE_MEMORY_HOST);
+      hypre_CSRMatrix    *A_diag = hypre_ParCSRMatrixDiag(A_h);
+      hypre_CSRMatrix    *A_offd = hypre_ParCSRMatrixOffd(A_h);
+      HYPRE_BigInt       *col_map_offd = hypre_ParCSRMatrixColMapOffd(A_h);
+      HYPRE_Int          *A_diag_i = hypre_CSRMatrixI(A_diag);
+      HYPRE_Int          *A_offd_i = hypre_CSRMatrixI(A_offd);
+      HYPRE_Int          *A_diag_j = hypre_CSRMatrixJ(A_diag);
+      HYPRE_Int          *A_offd_j = hypre_CSRMatrixJ(A_offd);
+      HYPRE_Real         *A_diag_data = hypre_CSRMatrixData(A_diag);
+      HYPRE_Real         *A_offd_data = hypre_CSRMatrixData(A_offd);
+
+      hypre_ParCSRMatrix *A_seq = NULL;
+      hypre_CSRMatrix    *A_seq_diag, *A_seq_offd;
+      hypre_ParVector    *F_seq = NULL, *U_seq = NULL;
+      HYPRE_Solver        coarse_solver = NULL;
+      HYPRE_Int          *A_seq_i, *A_seq_offd_i, *A_seq_j;
+      HYPRE_Real         *A_seq_data;
+      HYPRE_Int          *A_tmp_i, *A_tmp_j;
+      HYPRE_Real         *A_tmp_data;
+      HYPRE_Int          *info, *displs, *nnz_counts, *nnz_displs;
+      HYPRE_Int           new_num_procs, my_id, i, j, cnt, size, num_nonzeros, total_nnz;
+      HYPRE_Int           all_solve = hypre_ParAMGDataRedundant(amg_data) ? 1 : 0;
+      HYPRE_Int           num_functions = hypre_ParAMGDataNumFunctions(amg_data);
+      hypre_IntArray     *dof_func = hypre_ParAMGDataDofFuncArray(amg_data)[level];
+      HYPRE_Int          *tmp_dof_func, *seq_dof_func = NULL;
+      HYPRE_BigInt        row_starts[2];
+
+      hypre_MPI_Comm_size(new_comm, &new_num_procs);
+      hypre_MPI_Comm_rank(new_comm, &my_id);
+
+      /* the rows of every rank and where they start: kept, for the cycles */
+      info = hypre_CTAlloc(HYPRE_Int, 2 * new_num_procs + 2, HYPRE_MEMORY_HOST);
+      displs = info + new_num_procs;
+      hypre_MPI_Allgather(&num_rows, 1, HYPRE_MPI_INT, info, 1, HYPRE_MPI_INT, new_comm);
+      displs[0] = 0;
+      for (i = 0; i < new_num_procs; i++)
+      {
+         displs[i + 1] = displs[i] + info[i];
+      }
+      size = displs[new_num_procs];
+
+      /* the function of every row, for a system: a hierarchy of one process that is told
+       * their number alone takes the rows for functions 0, 1, .. in turn, which the rows
+       * of a level below the first are not (they are those of its coarse points) */
+      if (num_functions > 1 && dof_func)
+      {
+         tmp_dof_func = hypre_TAlloc(HYPRE_Int, num_rows, HYPRE_MEMORY_HOST);
+         seq_dof_func = hypre_TAlloc(HYPRE_Int, size, HYPRE_MEMORY_HOST);
+         hypre_TMemcpy(tmp_dof_func, hypre_IntArrayData(dof_func), HYPRE_Int, num_rows,
+                       HYPRE_MEMORY_HOST, hypre_IntArrayMemoryLocation(dof_func));
+         hypre_MPI_Allgatherv(tmp_dof_func, num_rows, HYPRE_MPI_INT, seq_dof_func, info, displs,
+                              HYPRE_MPI_INT, new_comm);
+         hypre_TFree(tmp_dof_func, HYPRE_MEMORY_HOST);
+      }
+
+      /* this rank's rows, diagonal block first, with the columns' global indices */
+      num_nonzeros = A_diag_i[num_rows] + A_offd_i[num_rows];
+      A_tmp_i = hypre_CTAlloc(HYPRE_Int, num_rows, HYPRE_MEMORY_HOST);
+      A_tmp_j = hypre_CTAlloc(HYPRE_Int, num_nonzeros, HYPRE_MEMORY_HOST);
+      A_tmp_data = hypre_CTAlloc(HYPRE_Real, num_nonzeros, HYPRE_MEMORY_HOST);
+      cnt = 0;
+      for (i = 0; i < num_rows; i++)
+      {
+         A_tmp_i[i] = A_diag_i[i + 1] - A_diag_i[i] + A_offd_i[i + 1] - A_offd_i[i];
+         for (j = A_diag_i[i]; j < A_diag_i[i + 1]; j++)
+         {
+            A_tmp_j[cnt] = A_diag_j[j] + (HYPRE_Int) first_row_index;
+            A_tmp_data[cnt++] = A_diag_data[j];
+         }
+         for (j = A_offd_i[i]; j < A_offd_i[i + 1]; j++)
+         {
+            A_tmp_j[cnt] = (HYPRE_Int) col_map_offd[A_offd_j[j]];
+            A_tmp_data[cnt++] = A_offd_data[j];
+         }
+      }
+
+      /* the gathered matrix, in host memory */
+      A_seq_i = hypre_CTAlloc(HYPRE_Int, size + 1, HYPRE_MEMORY_HOST);
+      hypre_MPI_Allgatherv(A_tmp_i, num_rows, HYPRE_MPI_INT, &A_seq_i[1], info, displs,
+                           HYPRE_MPI_INT, new_comm);
+      for (i = 0; i < size; i++)
+      {
+         A_seq_i[i + 1] += A_seq_i[i];
+      }
+      total_nnz = A_seq_i[size];
+      nnz_counts = hypre_CTAlloc(HYPRE_Int, 2 * new_num_procs, HYPRE_MEMORY_HOST);
+      nnz_displs = nnz_counts + new_num_procs;
+      for (i = 0; i < new_num_procs; i++)
+      {
+         nnz_displs[i] = A_seq_i[displs[i]];
+         nnz_counts[i] = A_seq_i[displs[i + 1]] - A_seq_i[displs[i]];
+      }
+      A_seq_j = hypre_CTAlloc(HYPRE_Int, total_nnz, HYPRE_MEMORY_HOST);
+      A_seq_data = hypre_CTAlloc(HYPRE_Real, total_nnz, HYPRE_MEMORY_HOST);
+      hypre_MPI_Allgatherv(A_tmp_j, num_nonzeros, HYPRE_MPI_INT, A_seq_j, nnz_counts,
+                           nnz_displs, HYPRE_MPI_INT, new_comm);
+      hypre_MPI_Allgatherv(A_tmp_data, num_nonzeros, HYPRE_MPI_REAL, A_seq_data, nnz_counts,
+                           nnz_displs, HYPRE_MPI_REAL, new_comm);
+      hypre_TFree(nnz_counts, HYPRE_MEMORY_HOST);
+      hypre_TFree(A_tmp_i, HYPRE_MEMORY_HOST);
+      hypre_TFree(A_tmp_j, HYPRE_MEMORY_HOST);
+      hypre_TFree(A_tmp_data, HYPRE_MEMORY_HOST);
+      hypre_ParCSRMatrixDestroy(A_h);
+
+      if (all_solve || my_id == 0)
+      {
+         row_starts[0] = 0;
+         row_starts[1] = size;
+         A_seq = hypre_ParCSRMatrixCreate(hypre_MPI_COMM_SELF, size, size, row_starts,
+                                          row_starts, 0, total_nnz, 0);
+         A_seq_diag = hypre_ParCSRMatrixDiag(A_seq);
+         A_seq_offd = hypre_ParCSRMatrixOffd(A_seq);
+         A_seq_offd_i = hypre_CTAlloc(HYPRE_Int, size + 1, HYPRE_MEMORY_HOST);
+         hypre_CSRMatrixMemoryLocation(A_seq_diag) = HYPRE_MEMORY_HOST;
+         hypre_CSRMatrixMemoryLocation(A_seq_offd) = HYPRE_MEMORY_HOST;
+         hypre_CSRMatrixData(A_seq_diag) = A_seq_data;
+         hypre_CSRMatrixI(A_seq_diag) = A_seq_i;
+         hypre_CSRMatrixJ(A_seq_diag) = A_seq_j;
+         hypre_CSRMatrixI(A_seq_offd) = A_seq_offd_i;
+         /* the diagonal first in a row, then to the device */
+         hypre_CSRMatrixReorder(A_seq_diag);
+         hypre_ParCSRMatrixMigrate(A_seq, memory_location);
+
+         F_seq = hypre_ParVectorCreate(hypre_MPI_COMM_SELF, size, row_starts);
+         U_seq = hypre_ParVectorCreate(hypre_MPI_COMM_SELF, size, row_starts);
+         hypre_ParVectorInitialize_v2(F_seq, memory_location);
+         hypre_ParVectorInitialize_v2(U_seq, memory_location);
+
+         HYPRE_BoomerAMGCreate(&coarse_solver);
+         HYPRE_BoomerAMGSetMaxRowSum(coarse_solver, hypre_ParAMGDataMaxRowSum(amg_data));
+         HYPRE_BoomerAMGSetStrongThreshold(coarse_solver,
+                                           hypre_ParAMGDataStrongThreshold(amg_data));
+         HYPRE_BoomerAMGSetCoarsenType(coarse_solver, hypre_ParAMGDataCoarsenType(amg_data));
+         HYPRE_BoomerAMGSetInterpType(coarse_solver, hypre_ParAMGDataInterpType(amg_data));
+         HYPRE_BoomerAMGSetTruncFactor(coarse_solver, hypre_ParAMGDataTruncFactor(amg_data));
+         HYPRE_BoomerAMGSetPMaxElmts(coarse_solver, hypre_ParAMGDataPMaxElmts(amg_data));
+         if (hypre_ParAMGDataUserRelaxType(amg_data) > -1)
+         {
+            HYPRE_BoomerAMGSetRelaxType(coarse_solver, hypre_ParAMGDataUserRelaxType(amg_data));
+         }
+         HYPRE_BoomerAMGSetRelaxOrder(coarse_solver, hypre_ParAMGDataRelaxOrder(amg_data));
+         HYPRE_BoomerAMGSetRelaxWt(coarse_solver, hypre_ParAMGDataUserRelaxWeight(amg_data));
+         if (hypre_ParAMGDataUserNumSweeps(amg_data) > -1)
+         {
+            HYPRE_BoomerAMGSetNumSweeps(coarse_solver, hypre_ParAMGDataUserNumSweeps(amg_data));
+         }
+         HYPRE_BoomerAMGSetNumFunctions(coarse_solver, hypre_ParAMGDataNumFunctions(amg_data));
+         if (seq_dof_func)
+         {
+            /* (in the memory of the matrix; the solver frees them with itself) */
+            tmp_dof_func = hypre_TAlloc(HYPRE_Int, size, memory_location);
+            hypre_TMemcpy(tmp_dof_func, seq_dof_func, HYPRE_Int, size, memory_location,
+                          HYPRE_MEMORY_HOST);
+            HYPRE_BoomerAMGSetDofFunc(coarse_solver, tmp_dof_func);
+         }
+         HYPRE_BoomerAMGSetMaxIter(coarse_solver, 1);
+         HYPRE_BoomerAMGSetTol(coarse_solver, 0);
+
+#if defined(HYPRE_USING_CURAND) || defined(HYPRE_USING_ROCRAND)
+         if (all_solve)
+         {
+            /* the same random numbers for the coarsening on every rank */
+            hypre_ResetDeviceRandGenerator(1234ULL, 0ULL);
+         }
+#endif
+         hypre_BoomerAMGSetup(coarse_solver, A_seq, F_seq, U_seq);
+      }
+      else
+      {
+         hypre_TFree(A_seq_i, HYPRE_MEMORY_HOST);
+         hypre_TFree(A_seq_j, HYPRE_MEMORY_HOST);
+         hypre_TFree(A_seq_data, HYPRE_MEMORY_HOST);
+      }
+      hypre_TFree(seq_dof_func, HYPRE_MEMORY_HOST);
+
+      if (all_solve)
+      {
+         /* One right-hand side for all the ranks: do their solvers answer alike?  (To
+          * the square root of the unit round-off; solvers of two coarsenings differ in
+          * the first or second digit.) */
+         HYPRE_Real *probe = hypre_TAlloc(HYPRE_Real, size, HYPRE_MEMORY_HOST);
+         HYPRE_Real  v[2], lo[2], hi[2], most, tol = hypre_sqrt(HYPRE_REAL_EPSILON);
+
+         for (i = 0; i < size; i++)
+         {
+            probe[i] = (HYPRE_Real) ((((unsigned int) i * 2654435761U) >> 8) & 0xffffU) /
+                       65536.0 - 0.5;
+         }
+         hypre_TMemcpy(hypre_VectorData(hypre_ParVectorLocalVector(F_seq)), probe, HYPRE_Real,
+                       size, memory_location, HYPRE_MEMORY_HOST);
+         hypre_TFree(probe, HYPRE_MEMORY_HOST);
+         hypre_ParVectorSetZeros(U_seq);
+         hypre_BoomerAMGSolve(coarse_solver, A_seq, F_seq, U_seq);
+         v[0] = hypre_ParVectorInnerProd(U_seq, U_seq);
+         v[1] = hypre_ParVectorInnerProd(F_seq, U_seq);
+         hypre_MPI_Allreduce(v, lo, 2, HYPRE_MPI_REAL, hypre_MPI_MIN, new_comm);
+         hypre_MPI_Allreduce(v, hi, 2, HYPRE_MPI_REAL, hypre_MPI_MAX, new_comm);
+         for (i = 0; i < 2; i++)
+         {
+            most = hypre_max(hypre_abs(lo[i]), hypre_abs(hi[i]));
+            if (!(hi[i] - lo[i] <= tol * most))        /* (or one of them is not a number) */
+            {
+               all_solve = 0;
+            }
+         }
+         if (!all_solve && my_id > 0)
+         {
+            hypre_BoomerAMGDestroy(coarse_solver);
+            hypre_ParCSRMatrixDestroy(A_seq);
+            hypre_ParVectorDestroy(F_seq);
+            hypre_ParVectorDestroy(U_seq);
+            coarse_solver = NULL;
+            A_seq = NULL;
+            F_seq = U_seq = NULL;
+         }
+      }
+      hypre_SeqInfoAllSolve(info, new_num_procs) = all_solve;
+
+      hypre_ParAMGDataCoarseSolver(amg_data) = coarse_solver;
+      hypre_ParAMGDataACoarse(amg_data) = A_seq;
+      hypre_ParAMGDataFCoarse(amg_data) = F_seq;
+      hypre_ParAMGDataUCoarse(amg_data) = U_seq;
+      hypre_TFree(hypre_ParAMGDataCommInfo(amg_data), HYPRE_MEMORY_HOST);
+      hypre_ParAMGDataCommInfo(amg_data) = info;
+      hypre_ParAMGDataNewComm(amg_data) = new_comm;
+   }
+
+   return hypre_error_flag;
+}
+
+static HYPRE_Int
+hypre_seqAMGCycleDevice( hypre_ParAMGData  *amg_data,
+                         HYPRE_Int          p_level,
+                         hypre_ParVector  **Par_F_array,
+                         hypre_ParVector  **Par_U_array )
+{
+   HYPRE_Int *info = hypre_ParAMGDataCommInfo(amg_data);
+
+   if (info)                                          /* (a rank that holds rows of the level) */
+   {
+      MPI_Comm              new_comm = hypre_ParAMGDataNewComm(amg_data);
+      HYPRE_Solver          coarse_solver = hypre_ParAMGDataCoarseSolver(amg_data);
+      hypre_ParCSRMatrix   *A_coarse = hypre_ParAMGDataACoarse(amg_data);
+      hypre_ParVector      *F_coarse = hypre_ParAMGDataFCoarse(amg_data);
+      hypre_ParVector      *U_coarse = hypre_ParAMGDataUCoarse(amg_data);
+      hypre_Vector         *u_local = hypre_ParVectorLocalVector(Par_U_array[p_level]);
+      hypre_Vector         *f_local = hypre_ParVectorLocalVector(Par_F_array[p_level]);
+      HYPRE_MemoryLocation  memory_location = hypre_VectorMemoryLocation(u_local);
+      HYPRE_Int             n = hypre_VectorSize(u_local);
+      HYPRE_Int            *displs;
+      HYPRE_Int             new_num_procs, my_id, size;
+      HYPRE_Real           *mine, *all;
+
+      hypre_MPI_Comm_size(new_comm, &new_num_procs);
+      hypre_MPI_Comm_rank(new_comm, &my_id);
+      displs = info + new_num_procs;
+      size = displs[new_num_procs];
+      mine = hypre_TAlloc(HYPRE_Real, n, HYPRE_MEMORY_HOST);
+      all = hypre_TAlloc(HYPRE_Real, size, HYPRE_MEMORY_HOST);
+
+      hypre_TMemcpy(mine, hypre_VectorData(f_local), HYPRE_Real, n,
+                    HYPRE_MEMORY_HOST, memory_location);
+      hypre_MPI_Allgatherv(mine, n, HYPRE_MPI_REAL, all, info, displs, HYPRE_MPI_REAL, new_comm);
+      if (coarse_solver)
+      {
+         hypre_TMemcpy(hypre_VectorData(hypre_ParVectorLocalVector(F_coarse)), all, HYPRE_Real,
+                       size, memory_location, HYPRE_MEMORY_HOST);
+      }
+      if (p_level > 0)
+      {
+         if (coarse_solver)
+         {
+            hypre_ParVectorSetZeros(U_coarse);
+         }
+      }
+      else
+      {
+         hypre_TMemcpy(mine, hypre_VectorData(u_local), HYPRE_Real, n,
+                       HYPRE_MEMORY_HOST, memory_location);
+         hypre_MPI_Allgatherv(mine, n, HYPRE_MPI_REAL, all, info, displs, HYPRE_MPI_REAL,
+                              new_comm);
+         if (coarse_solver)
+         {
+            hypre_TMemcpy(hypre_VectorData(hypre_ParVectorLocalVector(U_coarse)), all,
+                          HYPRE_Real, size, memory_location, HYPRE_MEMORY_HOST);
+            hypre_ParVectorAllZeros(U_coarse) = 0;
+         }
+      }
+
+      if (coarse_solver)
+      {
+         hypre_BoomerAMGSolve(coarse_solver, A_coarse, F_coarse, U_coarse);
+      }
+
+      if (hypre_SeqInfoAllSolve(info, new_num_procs))
+      {
+         /* this rank's rows of its own solution, device to device */
+         hypre_TMemcpy(hypre_VectorData(u_local),
+                       hypre_VectorData(hypre_ParVectorLocalVector(U_coarse)) + displs[my_id],
+                       HYPRE_Real, n, memory_location, memory_location);
+      }
+      else
+      {
+         /* the first rank's solution, to all */
+         if (my_id == 0)
+         {
